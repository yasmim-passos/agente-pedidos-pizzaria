# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# Chave criada no Google AI Studio
GEMINI_API_KEY=

# Nome do modelo, conforme a lista do Google AI Studio
GEMINI_MODEL=

# Endereço local da API da pizzaria (LAB06)
API_BASE_URL=http://localhost:8080

# JWT aceito pela API. Em ambiente local, é gerado por scripts/gerar_token_dev.py
API_TOKEN=
