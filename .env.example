# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# Chave criada no Google AI Studio
GEMINI_API_KEY=

# Nome do modelo, conforme a lista do Google AI Studio
GEMINI_MODEL=

# Endereço da API da pizzaria (LAB06). O docker compose expõe a porta 3333 pelo nginx.
API_BASE_URL=http://localhost:3333

# JWT aceito pela API da pizzaria
API_TOKEN=
